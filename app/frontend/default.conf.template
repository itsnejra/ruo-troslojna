# Šablon nginx konfiguracije. Ulazna skripta zvanične nginx slike pri startu zamjenjuje
# ${VARIJABLE} vrijednostima iz okruženja i rezultat piše u /etc/nginx/conf.d/default.conf.
# Zamjenjuju se samo varijable koje postoje u okruženju, pa nginx varijable ($host...) ostaju.

# Resolver se čita iz /etc/resolv.conf kontejnera (NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1), pa u kodu
# nema IP adrese DNS servera (AO-7). Na VM-u je to resolver VM-a (BIND preko systemd-resolved),
# a u razvojnom compose-u ugrađeni Docker DNS.
resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
resolver_timeout 3s;

server {
    # Oba protokola: "localhost" se u kontejneru (i na VM-u) razrješava prvo u ::1, pa bi nginx
    # koji sluša samo IPv4 odbijao lokalnu provjeru zdravlja (Connection refused).
    listen 80;
    listen [::]:80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'" always;

    # liveness samog frontenda (ne zavisi od backenda)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Sloj 1 -> sloj 2: jedini put prema backendu. Adresa je DNS ime (AO-7).
    # Ime je u varijabli, pa ga nginx razrješava u toku rada i poštuje TTL zapisa:
    # promjena DNS zapisa (npr. premještanje backenda) važi bez restarta frontenda.
    location /api/ {
        set $backend_upstream http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    location / {
        try_files $uri /index.html;
    }
}

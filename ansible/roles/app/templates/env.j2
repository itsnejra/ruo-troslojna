# {{ ansible_managed }}
# Vrijednosti za ${...} u compose.yaml. Nema tajni (one su datoteke u {{ app_secrets_dir }})
# ni adresa (komponente se adresiraju DNS imenima u zoni {{ ruo_zone }}).
APP_TAG={{ app_tag }}
DB_IMAGE={{ app_slike.db.ime }}
RUO_ZONE={{ ruo_zone }}
RUO_DATA_DIR={{ app_data_dir }}
RUO_ETC_DIR={{ app_etc_dir }}
RUO_SECRETS_DIR={{ app_secrets_dir }}
